#!/bin/sh
# Default tix plan hook. tix sends a ticket's parsed plan frontmatter as JSON
# on stdin; this prints the review tier. Copy it to <repo>/.tix/plan-hook or
# ~/.tix/plan-hook and edit the rules to suit the team. Requires jq.
#
#   tier 2: the plan adds concepts or changes contracts
#   tier 1: the plan spans several concepts or leaves decisions open
#   tier 0: everything else
exec jq -c '
  def n(f): (f // []) | length;
  if n(.new_concepts) > 0 or n(.contracts_changed) > 0 then
    {tier: 2, reason: "new concepts or changed contracts"}
  elif n(.concepts) > 1 or n(.decisions) > 0 then
    {tier: 1, reason: "multiple concepts or open decisions"}
  else
    {tier: 0}
  end'
